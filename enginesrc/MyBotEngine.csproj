<Project Sdk="Microsoft.NET.Sdk">
  <!-- Clean-room re-implementation of MyBot.run.dll, written from the documented
       behaviour of each exported function. This is our own code, licensed as we choose.
       It grows one verified group of functions at a time; until every export is covered
       it is not yet a drop-in replacement for the original DLL. -->
  <PropertyGroup>
    <AssemblyName>MyBotEngine</AssemblyName>
    <RootNamespace>MyBotEngine</RootNamespace>
    <TargetFramework>net45</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Library</OutputType>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <!-- tests are compiled separately (see tests/), not part of the shipped library -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
</Project>
